+// 失われる分をこのキューへ退避する。get_input_event() は
+// キューが空でない限りそこから 1 個ずつ取り出す。
+//
+// ネイティブ挙動との同一性について:
+//   ネイティブでは OS のイベントループが別に回っており、
+//   1 回の CheckMessages() に複数のキー入力が同時に溜まることは
+//   まずない（あっても取りこぼしは 1 フレーム分）。
+//   つまりこのキューは「ネイティブでは自然に成立していた
+//   1 入力 = 1 ターンの対応」をブラウザで復元するものであり、
+//   ゲームプレイの意味を変えるものではない。
+//   押した回数だけ移動する、という本来の CDDA の挙動になる。
+//
+// 上限を設ける理由:
+//   キーを押しっぱなしにした場合や、タブを長時間放置して戻った
+//   場合に無制限に溜まると、指を離した後も延々と動き続けて
+//   しまう（プレイ体験を損なう）。上限を超えた分は古いものから
+//   捨てる。64 は 1 秒間に 60 回来ても 1 秒ぶん保持できる値。
+static std::deque<input_event> pending_input_queue;
+static constexpr size_t pending_input_queue_max = 64;
+
+// last_input を上書きする直前に呼び、失われる入力を退避する。
+// error 型（=入力なし）は退避しない。
+static void stash_pending_input( const input_event &ev )
+{
+    if( ev.type == input_event_t::error || ev.type == input_event_t::timeout ) {
+        return;
+    }
+    // マウス移動は「最新の位置」以外に意味がないので溜めない。
+    // 溜めると移動キーの後ろに大量のマウス移動が並んで
+    // 実際の移動が遅延する。
+    if( ev.type == input_event_t::mouse
+        && ev.get_first_input() == static_cast<int>( MouseInput::Move ) ) {
+        return;
+    }
+    if( pending_input_queue.size() >= pending_input_queue_max ) {
+        pending_input_queue.pop_front();
+    }
+    pending_input_queue.push_back( ev );
+}
+
+// キューから 1 個取り出す。空なら error 型を返す。
+static input_event take_pending_input()
+{
+    if( pending_input_queue.empty() ) {
+        return input_event();
+    }
+    const input_event ev = pending_input_queue.front();
+    pending_input_queue.pop_front();
+    return ev;
+}
+
+// last_input が空（error）のときだけ、キューから 1 個補充する。
+// CheckMessages() の直後に呼ぶことで、
+// 「排出ループの最後のイベントが last_input を設定しない種類だった」
+// 場合の取りこぼしを防ぐ。
+static void drain_pending_input_if_idle()
+{
+    if( last_input.type == input_event_t::error && !pending_input_queue.empty() ) {
+        last_input = take_pending_input();
+    }
+}
+
+// 取り出したが使わなかった入力をキューの先頭へ戻す。
+// pump_events() が「入力を無視する」際に使う。破棄してはいけない。
+static void return_pending_input( const input_event &ev )
+{
+    if( ev.type == input_event_t::error || ev.type == input_event_t::timeout ) {
+        return;
+    }
+    if( pending_input_queue.size() >= pending_input_queue_max ) {
+        pending_input_queue.pop_back();
+    }
+    pending_input_queue.push_front( ev );
+}
+
+#else // !EMSCRIPTEN
+
