+    for( std::size_t i = 0; i < candidates.size(); ++i ) {
+        for( std::size_t j = i + 1; j < candidates.size(); ++j ) {
+            bool conflict = sources[i]->typeId() == sources[j]->typeId();
+            for( std::size_t b = 0; b < parts.size(); ++b ) {
+                const auto &a = candidates[i].parts[b];
+                const auto &other = candidates[j].parts[b];
+                if( a.coverage > 0 && other.coverage > 0 &&
