+#pragma once
+#ifndef CATA_SRC_CATA_GEAR_GUIDE_H
+#define CATA_SRC_CATA_GEAR_GUIDE_H
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Numeric, deterministic advisory model. It never owns items or a Character.
+// These are comparison indices, NOT the game's damage/temperature simulation.
+namespace cata_gear
+{
+constexpr std::size_t max_items = 48;
+constexpr std::size_t max_parts = 32;
+constexpr int max_passes = 8;
+using selection = std::uint64_t;
+
+struct part {
+    double coverage = 0;
+    std::array<double, 3> resist = {};
+    double encumbrance = 0;
+    double warmth = 0;
+    double breathability = 100;
+    std::uint32_t layers = 0;
+};
+struct candidate {
+    std::vector<part> parts;
+    double storage = 0;
+    double weight = 0;
+    selection conflicts = 0;
+    bool worn = false;
+    bool locked = false;
+};
+struct environment {
+    double celsius = 18;
+    std::vector<double> weights;
+    bool preserve_storage = true;
+};
+struct assessment {
+    std::vector<part> parts;
+    double protection = 0;
+    double coverage = 0;
+    double encumbrance = 0;
+    double thermal = 0;
+    double storage = 0;
+    double weight = 0;
+    double score = 0;
+};
+struct result {
+    selection chosen = 0;
+    int evaluations = 0;
+    bool capped = false;
+};
+
+inline selection bit( std::size_t i )
+{
+    return selection{ 1 } << i;
+}
+
+inline assessment assess( const std::vector<candidate> &items, selection chosen,
+                          const environment &env, int profile )
+{
+    assessment value;
+    value.parts.resize( env.weights.size() );
+    double sum_weights = 0;
+    const double target = std::clamp( ( 18.0 - env.celsius ) * 2.0, 0.0, 100.0 );
+    for( std::size_t b = 0; b < env.weights.size(); ++b ) {
+        part &total = value.parts[b];
+        std::uint32_t layers = 0;
+        for( std::size_t i = 0; i < items.size(); ++i ) {
+            if( !( chosen & bit( i ) ) ) {
+                continue;
+            }
+            const part &p = items[i].parts[b];
+            // Conservative coverage: do not assume independent gaps combine.
+            total.coverage = std::max( total.coverage, p.coverage );
+            for( int d = 0; d < 3; ++d ) {
+                total.resist[d] += p.resist[d] * p.coverage / 100.0;
+            }
+            total.encumbrance += p.encumbrance;
+            if( ( layers & p.layers ) != 0 ) {
+                total.encumbrance += std::clamp( p.encumbrance, 2.0, 10.0 );
+            }
+            layers |= p.layers;
+            total.warmth += p.warmth;
+            if( p.coverage > 0 ) {
+                total.breathability = std::min( total.breathability, p.breathability );
+            }
+        }
+        const double w = env.weights[b];
+        sum_weights += w;
+        value.coverage += w * total.coverage;
+        value.protection += w * ( total.resist[0] + total.resist[1] + total.resist[2] ) / 3.0;
+        value.encumbrance += w * total.encumbrance;
+        const double heat_factor = total.warmth > target ?
+                                   1.0 + ( 100.0 - total.breathability ) / 100.0 : 1.0;
+        value.thermal += w * std::abs( total.warmth - target ) * heat_factor;
+    }
+    sum_weights = std::max( 1.0, sum_weights );
+    value.coverage /= sum_weights;
+    value.protection /= sum_weights;
+    value.encumbrance /= sum_weights;
+    value.thermal /= sum_weights;
+    for( std::size_t i = 0; i < items.size(); ++i ) {
+        if( chosen & bit( i ) ) {
+            value.storage += items[i].storage;
+            value.weight += items[i].weight;
+        }
+    }
+    const double defense = profile == 1 ? 3.0 : 1.5;
+    const double mobility = profile == 2 ? 1.5 : 0.7;
+    const double comfort = profile == 2 ? 0.8 : 0.35;
+    value.score = defense * value.protection + 0.08 * value.coverage -
+                  mobility * value.encumbrance - comfort * value.thermal;
+    return value;
+}
+
+inline result recommend( const std::vector<candidate> &items, const environment &env,
+                         int profile )
+{
+    result best;
+    if( items.size() > max_items || env.weights.empty() || env.weights.size() > max_parts ) {
+        best.capped = true;
+        return best;
+    }
+    selection locked = 0;
+    for( std::size_t i = 0; i < items.size(); ++i ) {
+        if( items[i].parts.size() != env.weights.size() ) {
+            best.capped = true;
+            return best;
+        }
+        if( items[i].worn ) {
+            best.chosen |= bit( i );
+            if( items[i].locked ) {
+                locked |= bit( i );
+            }
+        }
+    }
+    const assessment baseline = assess( items, best.chosen, env, profile );
+    double score = baseline.score;
+    for( int pass = 0; pass < max_passes; ++pass ) {
+        selection next = best.chosen;
+        double next_score = score;
+        for( std::size_t i = 0; i < items.size(); ++i ) {
+            if( locked & bit( i ) ) {
+                continue;
+            }
+            selection trial = best.chosen ^ bit( i );
+            if( !( best.chosen & bit( i ) ) ) {
+                trial &= ~items[i].conflicts;
+            }
+            if( ( trial & locked ) != locked ) {
+                continue;
+            }
+            const assessment value = assess( items, trial, env, profile );
+            ++best.evaluations;
+            if( env.preserve_storage && value.storage + 0.001 < baseline.storage ) {
+                continue;
+            }
+            bool protected_coverage = true;
+            for( std::size_t b = 0; b < env.weights.size(); ++b ) {
+                if( value.parts[b].coverage < std::min( baseline.parts[b].coverage, 80.0 ) ) {
+                    protected_coverage = false;
+                }
+            }
+            if( protected_coverage && value.score > next_score + 0.001 ) {
+                next = trial;
+                next_score = value.score;
+            }
+        }
+        if( next == best.chosen ) {
+            return best;
+        }
+        best.chosen = next;
+        score = next_score;
+    }
+    best.capped = true;
+    return best;
+}
