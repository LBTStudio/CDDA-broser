+// Read-only, on-demand advice. No wear/takeoff/turn simulation is performed.
+static void show_gear_guide( Character &guy, const std::list<item> &worn )
+{
+    const std::vector<bodypart_id> parts = guy.get_all_body_parts();
+    if( parts.empty() || parts.size() > cata_gear::max_parts || worn.size() > cata_gear::max_items ) {
+        popup( "装備ナビ: 部位32・装備48の上限を超えています。装備は変更していません。" );
+        return;
+    }
+    const bool power_armor = guy.is_wearing_power_armor();
+    const auto special = []( const item & it ) {
+        return it.is_power_armor() || it.is_ablative() ||
+               it.has_flag( flag_INTEGRATED ) || it.has_flag( flag_NO_TAKEOFF ) ||
+               it.has_flag( flag_SPLINT ) || it.has_flag( flag_TOURNIQUET ) ||
+               it.has_flag( flag_RESTRICT_HANDS ) || it.has_flag( flag_SEMITANGIBLE );
+    };
+    std::vector<const item *> sources;
+    std::vector<cata_gear::candidate> candidates;
+    std::vector<bool> protected_items;
+    cata_gear::environment env;
+    const units::temperature temperature = get_weather().get_temperature( guy.pos_bub() );
+    env.celsius = units::to_celsius( temperature );
+    for( const bodypart_id &bp : parts ) {
+        env.weights.push_back( bp.id().str() == "torso" || bp.id().str() == "head" ? 3.0 : 1.0 );
+    }
+    const std::array<damage_type_id, 3> types = {
+        damage_type_id( "bash" ), damage_type_id( "cut" ), damage_type_id( "stab" )
+    };
+    const auto add = [&]( const item & it, bool is_worn ) {
+        cata_gear::candidate entry;
+        entry.worn = is_worn;
+        const bool protect = is_worn && ( power_armor || special( it ) || !it.empty() );
+        entry.locked = protect;
+        entry.storage = units::to_milliliter( it.get_total_capacity() ) / 1000.0;
+        entry.weight = units::to_gram( it.weight( false ) ) / 1000.0;
+        for( const bodypart_id &bp : parts ) {
+            cata_gear::part value;
+            if( it.covers( bp ) ) {
+                value.coverage = std::clamp( it.get_coverage( bp, item::cover_type::COVER_MELEE ), 0, 100 );
+                for( std::size_t d = 0; d < types.size(); ++d ) {
+                    // Explicit percentile: never roll RNG for a hypothetical hit.
+                    value.resist[d] = std::max( 0.0f, it.resist( types[d], false, bp, 50 ) );
+                }
+                value.encumbrance = std::max( 0, it.get_encumber( guy, bp ) );
+                value.warmth = std::max( 0, it.get_warmth( bp ) );
+                value.breathability = std::clamp( it.breathability( bp ), 0, 100 );
+                for( layer_level layer : it.get_layer( bp ) ) {
+                    const unsigned index = static_cast<unsigned>( layer );
+                    if( index < 32 ) {
+                        value.layers |= std::uint32_t{ 1 } << index;
+                    }
+                }
+            }
+            entry.parts.push_back( value );
+        }
+        sources.push_back( &it );
+        candidates.push_back( entry );
+        protected_items.push_back( protect );
+    };
+    for( const item &it : worn ) {
+        add( it, true );
+    }
+    const std::size_t worn_count = candidates.size();
