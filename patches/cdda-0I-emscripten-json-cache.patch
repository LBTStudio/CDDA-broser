--- a/src/json_loader.cpp
+++ b/src/json_loader.cpp
@@ -4,6 +4,14 @@
 #include <memory>
 #include <unordered_map>
 
+#if defined(EMSCRIPTEN)
+#include <cctype>
+#include <cstdlib>
+#include <string>
+#include <system_error>
+#include "get_version.h"
+#endif
+
 #include "filesystem.h"
 #include "flexbuffer_cache.h"
 #include "flexbuffer_json.h"
@@ -11,9 +19,64 @@
 
 namespace
 {
+#if defined(EMSCRIPTEN)
+// The web build unpacks all game data into volatile MEMFS on every page
+// load, so the stock cache directories (<base>/cache, <data>/cache) vanish
+// between visits and every start re-parses ~60MB of core JSON during the
+// "core loading / finalization" phase.  Keep those caches inside the
+// persisted user directory (IDBFS) instead, keyed by the data package
+// identity so a game update invalidates them wholesale: the packaged
+// files' mtimes are meaningless (fresh each load), so the flexbuffer
+// cache runs in assume-immutable-root mode and versioning the directory
+// is the only invalidation needed.  Caches from other versions are
+// removed to keep IndexedDB usage bounded.
+std::filesystem::path web_data_cache_root()
+{
+    static const std::filesystem::path root = []() {
+        // The shell exports the data package's HTTP ETag; fall back to the
+        // game version string when it is unavailable (stock loader path).
+        const char *tag_env = std::getenv( "CDDA_DATA_VERSION" );
+        std::string tag = tag_env != nullptr ? tag_env : "";
+        if( tag.empty() ) {
+            tag = getVersionString();
+        }
+        for( char &c : tag ) {
+            const unsigned char uc = static_cast<unsigned char>( c );
+            if( std::isalnum( uc ) == 0 && c != '.' && c != '-' && c != '_' ) {
+                c = '_';
+            }
+        }
+        if( tag.empty() ) {
+            tag = "unversioned";
+        }
+        const std::filesystem::path base = std::filesystem::u8path( PATH_INFO::user_dir() ) /
+                                           std::filesystem::u8path( "json_cache" );
+        std::error_code ec;
+        if( std::filesystem::is_directory( base, ec ) ) {
+            for( const std::filesystem::directory_entry &entry :
+                 std::filesystem::directory_iterator( base, ec ) ) {
+                if( entry.path().filename().u8string() != tag ) {
+                    std::error_code remove_ec;
+                    std::filesystem::remove_all( entry.path(), remove_ec );
+                }
+            }
+        }
+        const std::filesystem::path versioned = base / std::filesystem::u8path( tag );
+        // Also schedules an IDBFS sync via the filesystem.cpp hook.
+        assure_dir_exist( versioned );
+        return versioned;
+    }();
+    return root;
+}
+#endif
+
 flexbuffer_cache &base_cache()
 {
+#if defined(EMSCRIPTEN)
+    static flexbuffer_cache cache{ web_data_cache_root() / "base", PATH_INFO::base_path().get_unrelative_path(), true };
+#else
     static flexbuffer_cache cache{ ( PATH_INFO::base_path() / "cache" ).get_unrelative_path(), PATH_INFO::base_path().get_unrelative_path() };
+#endif
     return cache;
 }
 
