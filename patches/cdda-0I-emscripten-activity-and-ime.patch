@@ -0,0 +1,115 @@
+#pragma once
+#ifndef CATA_SRC_CATA_WEB_TEXT_INPUT_H
+#define CATA_SRC_CATA_WEB_TEXT_INPUT_H
+
+// [CDDA-BROWSER] 「今テキスト入力欄が開いているか」を明示的に管理する。
+//
+// なぜ必要か（詳細は docs/measurements/FACTS.md F-18）:
+//
+//   ブラウザの IME は「フォーカスされた編集可能 DOM 要素」に対してのみ
+//   変換を行う。ゲームの canvas は composition イベントを一切受け取れない
+//   ため、シェル側に隠しの <input>（IME プロキシ）を置き、テキスト入力中
+//   だけそこへフォーカスを移して変換結果を SDL_TEXTINPUT として
+//   注入している。
+//
+//   したがって「テキスト入力中か否か」の判定が誤ると、
+//     - 誤って false → プロキシにフォーカスが当たらず日本語が打てない
+//     - 誤って true  → 移動キーが全部かな変換に食われて操作不能
+//   のどちらかが起きる。両方向に厳しい判定である。
+//
+//   従来実装は Android 由来の is_string_input() を真似て
+//   input_context_stack の先頭のカテゴリ名（"STRING_INPUT" 等）を
+//   見ていたが、これは以下の理由で破綻する:
+//
+//   1. input_popup（ImGui 版の文字入力）は
+//        ctxt = input_context( "STRING_INPUT", keyboard_mode::keychar );
+//      と「コピー代入」で文脈を設定する。ところが
+//      input_context::operator= は __ANDROID__ 限定でしか定義されておらず、
+//      しかもスタック操作を一切行わない。結果、右辺の一時オブジェクトが
+//      自分をスタックに積んで自分のデストラクタで降ろす一方、
+//      実際に入力を受けるメンバ ctxt はカテゴリ "default" のまま
+//      スタックに残る。スタック先頭を見ても "STRING_INPUT" は現れない。
+//
+//   2. inventory_selector::query_string() や uilist::inputfilter() は
+//        do { ui_manager::redraw(); spopup->query_string( false ); }
+//        while( !confirmed && !canceled );
+//      という構造で、囲んでいるセレクタ自身の input_context も
+//      同時にスタック上にある。どちらが先頭になるかは
+//      呼び出しの入れ子順に依存し、テキスト入力中でも
+//      先頭が "INVENTORY" などになる瞬間がある。
+//
+//   つまりスタック先頭の推測では原理的に安定しない。
+//   そこで「テキスト入力欄オブジェクトの生存期間」という
+//   本来の情報を RAII で直接持たせる。入れ子や再入があり得るので
+//   参照カウントにする。
+//
+// 非 Emscripten ビルドでは完全な空実装になり、挙動は一切変わらない。
+
+#if defined(EMSCRIPTEN)
+
+namespace cata_web
+{
+
+/**
+ * テキスト入力欄が生存している間だけ立てるスコープ。
+ *
+ * string_input_popup / input_popup / string_editor_window の
+ * コンストラクタ・デストラクタに埋め込んで使う。
+ *
+ * 「query_string() の呼び出し 1 回」ではなく「入力欄オブジェクトの寿命」
+ * に紐付けるのが重要。query_string( loop = false ) は呼び出し側の
+ * do-while から毎フレーム呼ばれるため、関数スコープに置くと
+ * on/off が毎フレーム往復し、DOM フォーカスが暴れる。
+ *
+ * 入れ子（入力欄の上にさらに入力欄）に対応するため参照カウント方式。
+ */
+class text_input_scope
+{
+    public:
+        text_input_scope();
+        ~text_input_scope();
+
+        // 誤ってコピー・移動されるとカウントが壊れるので禁止する。
+        text_input_scope( const text_input_scope & ) = delete;
+        text_input_scope &operator=( const text_input_scope & ) = delete;
+        text_input_scope( text_input_scope && ) = delete;
+        text_input_scope &operator=( text_input_scope && ) = delete;
+};
+
+/** 現在テキスト入力欄が 1 つ以上生存しているか。 */
+bool text_input_active();
+
+/** 生存しているスコープ数（デバッグ・検証用）。 */
+int text_input_depth();
+
+/**
+ * オブジェクト寿命ではなく状態フラグで入力欄を表す場合の設定関数。
+ *
+ * キーバインドメニュー（input_context::display_menu）の絞り込みは
+ * 専用の入力欄クラスを持たず、keybindings_ui::status が
+ * kb_menu_status::filter か否かという状態で表される。
+ * この種の経路では RAII が使えないので、状態変化のたびに設定する。
+ *
+ * 同じ呼び出し元から重複して true / false を渡しても
+ * カウントは 1 を超えない（冪等）。
+ *
+ * @param key    呼び出し元を識別する定数文字列リテラルのアドレス。
+ *               同一箇所からの重複設定を検出するために使う。
+ * @param active 入力欄が有効か。
+ */
+void set_text_input_flag( const void *key, bool active );
+
+} // namespace cata_web
+
+// メンバとして持たせるための型エイリアス。
+// クラス定義に 1 行加えるだけでスコープが寿命に一致する。
+#define CATA_WEB_TEXT_INPUT_MEMBER cata_web::text_input_scope cata_web_text_input_scope_;
+
+#else // !EMSCRIPTEN
+
+// 非 Emscripten ではメンバも増やさない（sizeof を変えない）。
+#define CATA_WEB_TEXT_INPUT_MEMBER
+
+#endif // EMSCRIPTEN
+
+#endif // CATA_SRC_CATA_WEB_TEXT_INPUT_H
diff --git a/src/cata_web_yield.cpp b/src/cata_web_yield.cpp
new file mode 100644
index 0000000..d479465
--- /dev/null
+++ b/src/cata_web_yield.cpp
@@ -0,0 +1,107 @@
+#include "cata_web_yield.h"
+
+#if defined(EMSCRIPTEN)
+
+#include <emscripten.h>
+
+namespace
+{
+
+// MessageChannel ベースの yield 本体。
+//
+// EM_ASYNC_JS は本体内の await を Asyncify の一時停止点に変換する。
+// ポートは 1 度だけ作って Module に載せ、以降は再利用する
+// （MessageChannel の生成自体は安くないため）。
+//
+// port1.onmessage は「1 タスクでキュー全体を捌く」形にしている。
+// 1 マクロタスクにつき 1 コールバックしか呼ばない実装にすると、
+// 同一フレーム内で複数の yield が積まれた場合に不要な往復が増える。
+EM_ASYNC_JS( void, cata_web_yield_impl, (), {
+    if( !Module._cataWebYieldChannel )
+    {
+        var ch = new MessageChannel();
+        var pending = [];
+        ch.port1.onmessage = function() {
+            var queue = pending;
+            pending = [];
+            for( var i = 0; i < queue.length; ++i ) {
+                queue[i]();
+            }
+        };
+        Module._cataWebYieldChannel = {
+            channel: ch,
+            push: function( resolve ) {
+                pending.push( resolve );
+                ch.port2.postMessage( 0 );
+            }
+        };
+    }
+    await new Promise( function( resolve ) {
+        Module._cataWebYieldChannel.push( resolve );
+    } );
+} );
+
+// requestAnimationFrame 待ち。描画を 1 枚確実に挟みたい場所専用。
+EM_ASYNC_JS( void, cata_web_yield_paint_impl, (), {
+    await new Promise( function( resolve ) {
+        requestAnimationFrame( function() {
+            resolve();
+        } );
+    } );
+} );
+
+// Asyncify の巻き戻しは入れ子にできないため、再入を弾く。
+// 例えば pump_events() の中から redraw が走り、その先でまた
+// yield 判定に到達する経路が存在する。
+bool yield_in_progress = false;
+
+} // namespace
+
+namespace cata_web
+{
+
+double now_ms()
+{
+    return emscripten_get_now();
+}
+
+void yield_now()
+{
+    if( yield_in_progress ) {
+        return;
+    }
+    yield_in_progress = true;
+    cata_web_yield_impl();
+    yield_in_progress = false;
+}
+
+void yield_paint()
+{
+    if( yield_in_progress ) {
+        return;
+    }
+    yield_in_progress = true;
+    cata_web_yield_paint_impl();
+    yield_in_progress = false;
+}
+
+bool yield_if_due( double &last_yield_ms, const double budget_ms )
+{
+    if( yield_in_progress ) {
+        return false;
+    }
+    const double now = emscripten_get_now();
+    if( now - last_yield_ms < budget_ms ) {
+        return false;
+    }
+    yield_now();
+    // yield 後の時刻で更新する。yield 自体の所要時間を予算から
+    // 差し引かないと、重い描画が挟まったときに次の yield が
+    // 即座に来てしまう。
+    last_yield_ms = emscripten_get_now();
+    return true;
+}
+
+} // namespace cata_web
+
+#endif // EMSCRIPTEN
diff --git a/src/cata_web_yield.h b/src/cata_web_yield.h
new file mode 100644
index 0000000..2da1415
--- /dev/null
+++ b/src/cata_web_yield.h
@@ -0,0 +1,110 @@
+#pragma once
+#ifndef CATA_SRC_CATA_WEB_YIELD_H
+#define CATA_SRC_CATA_WEB_YIELD_H
+
+// [CDDA-BROSER] ブラウザに制御を返すための共有プリミティブ。
+//
+// なぜ専用の仕組みが必要か（詳細は docs/measurements/FACTS.md F-01）:
+//
+//   emscripten_sleep( 0 ) は setTimeout(0) に落ちる。HTML Standard の
+//   timer initialization steps は、ネストレベル 5 以上のタイマーを
+//   最低 4ms にクランプすると規定している。ターン処理や JSON ロードの
+//   ように「1 ループごとに yield したい」経路ではこのネストが常に
+//   成立するため、yield 1 回あたり実測 4.25ms の純粋な待ち時間が乗る。
+//   Asyncify のスタック巻き戻しは原因ではない（スタック深度 0 でも
+//   1024 でも 4.25ms から動かないことを実測で確認済み）。
+//
+//   MessageChannel の postMessage はマクロタスクだがクランプ対象外で、
+//   実測 0.075ms（57 倍速い）。しかも requestAnimationFrame は
+//   その隙間で通常どおり 60fps 前後で発火し続けるので、描画も止まらない。
+//
+// 実測での効果:
+//   - 400 ターン処理: 2202ms → 411ms（5.4 倍）
+//   - 同時に最大描画停止: 258.8ms → 27.0ms（約 10 分の1）
+//   - JSON ロード 60142 オブジェクト: 描画停止 259.4ms → 32.6ms
+//
+// 非 Emscripten ビルドでは全て空実装になり、挙動は一切変わらない。
+
+#if defined(EMSCRIPTEN)
+
+namespace cata_web
+{
+
+/**
+ * 既定の時間予算（ミリ秒）。
+ *
+ * 16ms = 60fps の 1 フレーム。実測（FACTS.md F-15）では 8ms まで
+ * 詰めても描画フレーム数は増えず（表示側が 60fps 上限）、yield 回数だけが
+ * 倍になるため 16ms が最適点である。
+ */
+constexpr double default_budget_ms = 16.0;
+
+/**
+ * 現在時刻（ミリ秒、単調増加）。emscripten_get_now() の薄いラッパ。
+ *
+ * ヘッダに <emscripten.h> を持ち込まずに時間予算判定を書けるようにするため。
+ */
+double now_ms();
+
+/**
+ * ブラウザに制御を返す。MessageChannel 経由なので setTimeout の
+ * 4ms クランプを受けない。
+ *
+ * 再入は内部で抑止される（Asyncify の入れ子巻き戻しは不正なため）。
+ * 再入時は何もせず即座に戻る。
+ */
+void yield_now();
+
+/**
+ * 描画フレームを 1 枚確実に挟んでから戻る（requestAnimationFrame 待ち）。
+ *
+ * 実測ではディスプレイ同期のため 1 回 15.9ms かかる。ロード画面の
+ * 進捗表示のように「確実に 1 枚描かせたい」場所だけで使う。
+ * ターン処理のようなホットパスでは yield_now() を使うこと。
+ */
+void yield_paint();
+
+/**
+ * 時間予算付き yield。
+ *
+ * @param last_yield_ms 前回 yield した時刻。yield したら更新される。
+ *                      呼び出し側が static などで保持する。
+ * @param budget_ms     この時間以上経過していたら yield する。
+ * @return              実際に yield したら true。
+ *
+ * 判定自体のコストは無視できる（FACTS.md F-15: 60142 回の判定で
+ * yield なしとの差は誤差）。判定の間引きは不要。
+ */
