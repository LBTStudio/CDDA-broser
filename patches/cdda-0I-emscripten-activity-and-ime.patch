--- /dev/null
+++ b/src/cata_web_text_input.cpp
@@ -0,0 +1,66 @@
+#include "cata_web_text_input.h"
+
+#if defined(EMSCRIPTEN)
+
+#include <set>
+
+namespace
+{
+// 生存しているテキスト入力スコープの数。
+//
+// wasm はシングルスレッドなので、単純な int で足りる。
+// （Emscripten の pthread ビルドでも CDDA のゲームロジックは
+//   メインスレッドに閉じている。）
+int text_input_refcount = 0;
+
+// set_text_input_flag() で有効化された呼び出し元の集合。
+// 同一箇所からの重複設定でカウントが壊れないようにする。
+std::set<const void *> &active_flags()
+{
+    static std::set<const void *> flags;
+    return flags;
+}
+} // namespace
+
+namespace cata_web
+{
+
+text_input_scope::text_input_scope()
+{
+    ++text_input_refcount;
+}
+
+text_input_scope::~text_input_scope()
+{
+    if( text_input_refcount > 0 ) {
+        --text_input_refcount;
+    }
+}
+
+bool text_input_active()
+{
+    return text_input_refcount > 0;
+}
+
+int text_input_depth()
+{
+    return text_input_refcount;
+}
+
+void set_text_input_flag( const void *const key, const bool active )
+{
+    if( active ) {
+        // insert().second が false なら既に有効。二重計上を避ける。
+        if( active_flags().insert( key ).second ) {
+            ++text_input_refcount;
+        }
+    } else {
+        if( active_flags().erase( key ) > 0 && text_input_refcount > 0 ) {
+            --text_input_refcount;
+        }
+    }
+}
+
+} // namespace cata_web
+
+#endif // EMSCRIPTEN
diff --git a/src/cata_web_text_input.h b/src/cata_web_text_input.h
