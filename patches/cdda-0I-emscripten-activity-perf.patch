+// 同時に、これは報告にあった「どの程度作業に時間を要するかが
+// 判然としない」への直接の答えにもなる。行動が終わったときに
+// 「何ターンで何 ms だったか」が必ず残るためである。
+//
+// 【常時有効にする理由】
+// デバッグメニューから有効化する方式だと、報告を受けたときに
+// 「まず有効化してもう一度やってください」という往復が必要になる。
+// 集計コストは steady_clock の読み取り 1 回と整数加算数個だけで、
+// 計測対象（1 ターン数百マイクロ秒以上）に対して無視できる。
+// 報告はアクティビティ終了時の 1 回だけなのでログを汚さない。
+//
+// 【この関数を do_turn.cpp に置く理由】
+// game.h / game.cpp に持たせる実装も書いたが撤回した。
+// game.cpp は約 14000 行で巨大なヘッダ群を含み、本サンドボックス
+// （メモリ 985MB / 2 コア）では構文検証すら完走しない。
+// 検証できない変更を入れるのは F-27 の再来なので、
+// 呼び出し元と同じ翻訳単位に閉じて必ず検証できる形にした。
+// 状態は関数 static で保持する（1 ゲームに 1 つで十分）。
+void sample_activity_turn( const avatar &u )
+{
+    using clock = std::chrono::steady_clock;
+
+    static bool active = false;
+    static std::string current_verb;
+    static int turns = 0;
+    static clock::time_point started;
+
+    const auto report = []() {
+        // 1 ターンで終わる行動は報告しない。
+        // 役に立たないうえログを埋めるだけである。
+        if( turns < 2 ) {
+            return;
+        }
+        const long long elapsed =
+            std::chrono::duration_cast<std::chrono::milliseconds>(
+                clock::now() - started ).count();
+        const double per_turn = turns > 0
+                                ? static_cast<double>( elapsed ) / turns
+                                : 0.0;
+        add_msg( m_info,
+                 //~ %1$s は行動名、%2$d はターン数、%3$d は実時間(ms)、%4$.3f は 1 ターンあたり(ms)
+                 _( "[perf] %1$s: %2$d turns in %3$d ms (%4$.3f ms/turn)" ),
+                 current_verb, turns, static_cast<int>( elapsed ), per_turn );
+    };
+
+    const bool in_activity = static_cast<bool>( u.activity ) ||
+                             u.has_effect( effect_sleep );
+
+    if( in_activity ) {
+        const std::string verb = u.activity
+                                 ? u.activity.get_verb().translated()
+                                 : std::string( "sleep" );
+        if( !active ) {
+            active = true;
+            current_verb = verb;
+            turns = 0;
+            started = clock::now();
+        } else if( verb != current_verb ) {
+            // 別のアクティビティに切り替わった。前の分を報告して測り直す。
+            // 報告せずに捨てると、連続作業（解体 → 粉砕など）の
+            // 内訳が分からなくなる。
+            report();
+            current_verb = verb;
+            turns = 0;
+            started = clock::now();
+        }
+        ++turns;
+        return;
+    }
+
+    if( active ) {
+        report();
+        active = false;
+        turns = 0;
+        current_verb.clear();
+    }
+}
