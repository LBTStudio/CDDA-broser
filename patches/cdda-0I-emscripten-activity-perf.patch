+        // タイルで実行すると「いつ終わるのか分からないまま待たされる」
+        // ことになる（docs/measurements/FACTS.md F-29）。
+        //
+        // ネイティブでは 1 死体 30 ターン以上が一瞬で終わるので
+        // 情報が無くても困らないが、ブラウザでは 1 ターン 0.86ms
+        // （F-18）なので死体 20 個で 0.5 秒以上かかる。
+        // 「残り何個か」「今の死体が何%か」が見えるだけで
+        // 体感は大きく変わる。
+        //
+        // 表示はゲームプレイに影響しない（読み取り専用）。
+        std::string get_progress_message( const player_activity & ) const override;
+
         std::unique_ptr<activity_actor> clone() const override {
             return std::make_unique<pulp_activity_actor>( *this );
         }
