+// [CDDA-BROWSER] 粉砕の進捗表示。
+//
+// 上流は本関数を実装しておらず、既定実装（activity_actor.cpp の
+// 空文字列を返すもの）が使われるため、画面には verb だけの
+// 「Smashing…」しか出ない。残り死体数も現在の死体の進捗も
+// 分からないため、複数の死体が重なったタイルで実行すると
+// 「いつ終わるのか分からないまま待たされる」ことになる。
+//
+// なぜブラウザで問題になるか（docs/measurements/FACTS.md F-29）:
+//   pulp_activity_actor::do_turn は「1 ターンで死体 1 個だけ」叩く
+//   （同 :8762 の return コメント）。1 死体を壊すには time_to_pulp
+//   回叩く必要があり、人間サイズ（62.5L）で最低 30 ターン
+//   （game.cpp:14345 min_time_to_pulp = 30 * volume / 62.5）。
+//   ブラウザでは 1 ターンの全パイプラインが 0.86ms（F-18）なので
+//   死体 20 個なら 600 ターン = 約 0.5 秒かかる。
+//
+// 表示内容:
+//   死体が複数残っている場合   「残り N 体 (P%)」
+//   最後の 1 体の場合         「(P%)」
+//   P は現在叩いている死体の損傷度から出す。
+//
+// 本関数は const で、item の damage() / max_damage() を読むだけ。
+// ゲーム状態を変更しないので、挙動に影響しない。
+std::string pulp_activity_actor::get_progress_message( const player_activity & ) const
+{
+    // 現在叩いている死体を探す。do_turn と同じ走査順（後ろから）に
+    // することで、表示される死体と実際に叩かれる死体を一致させる。
+    // 一致していないと「進捗が進んでいるのに数字が動かない」
+    // という別種の分かりにくさを生む。
+    const item *current = nullptr;
+    int remaining = 0;
+    for( int i = corpses.size() - 1; i >= 0; --i ) {
+        const item *corpse = corpses[i].get_item();
+        if( corpse != nullptr && corpse->damage() < corpse->max_damage() ) {
+            if( current == nullptr ) {
+                current = corpse;
+            }
+            ++remaining;
+        }
+    }
+
+    if( current == nullptr ) {
+        // 走査対象が無い（直後に activity が終わる）。
+        // 空文字列を返すと呼び出し側が verb だけを表示するので、
+        // 上流の既定と同じ見た目になる。
+        return std::string();
+    }
+
+    // 損傷度から進捗率を出す。max_damage() は 0 になり得ないが、
+    // 万一 0 でもゼロ除算しないようにする。
+    const int maxd = current->max_damage();
+    const int pct = maxd > 0
+                    ? std::min( 100, ( current->damage() * 100 ) / maxd )
+                    : 0;
+
+    if( remaining > 1 ) {
+        //~ 粉砕の進捗。%1$d は残りの死体数、%2$d は現在の死体の進捗率
+        return string_format( n_gettext( "%1$d corpse left (%2$d%%)",
+                                         "%1$d corpses left (%2$d%%)",
+                                         remaining ),
+                              remaining, pct );
+    }
+    return string_format( "%d%%", pct );
+}
