+// Called after ImGui receives the original event. Text/IME is not coalesced.
+static bool filter_web_key_repeat( const SDL_Event &ev, const bool keycode_mode )
+{
+    if( !keycode_mode ) {
+        pending_key_repeat.reset();
+    }
+    if( ev.type == SDL_WINDOWEVENT ) {
+        switch( ev.window.event ) {
+            case SDL_WINDOWEVENT_FOCUS_LOST:
+            case SDL_WINDOWEVENT_HIDDEN:
+            case SDL_WINDOWEVENT_MINIMIZED:
+                web_repeat_focused = false;
+                pending_key_repeat.reset();
+                break;
+            case SDL_WINDOWEVENT_FOCUS_GAINED:
+                web_repeat_focused = true;
+                break;
+            default:
+                break;
+        }
+    } else if( ev.type == SDL_KEYUP ) {
+        // Also invalidate captured modifiers on release. Other held keys can
+        // produce a new repeat; no deliberate press is removed from the FIFO.
+        pending_key_repeat.reset();
+        return keycode_mode;
+    } else if( ev.type == SDL_KEYDOWN ) {
+        if( !ev.key.repeat ) {
+            pending_key_repeat.reset();
+        } else if( keycode_mode ) {
+            if( web_repeat_focused ) {
+                pending_key_repeat = ev.key.keysym;
+            }
+            return true;
+        }
+    }
+    return false;
