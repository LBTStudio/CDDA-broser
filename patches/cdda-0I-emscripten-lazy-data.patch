+#if defined( EMSCRIPTEN )
+#include <emscripten.h>
+
+// [CDDA-BROSER] 分割データパックを読み込み直前に差し込む。EM_ASYNC_JS はこのビルドで既に
+// 使われている仕組み（Asyncify / JSPI）で、ゲームのロジックには触れない。
+// 分割していない配布物では Module['cddaEnsurePack'] が無いので即座に戻る。
+// 定義を init.cpp に 1 つだけ置くのは、ヘッダに書くと複数の翻訳単位が
+// 同じ __em_js__ シンボルを定義してしまうため。
+EM_ASYNC_JS( int, cata_web_ensure_pack_js, ( const char *spec ), {
+    if( typeof Module === 'undefined' || !Module['cddaEnsurePack'] ) {
+        return 0;
+    }
+    try {
+        await Module['cddaEnsurePack']( UTF8ToString( spec ) );
+        return 1;
+    } catch( e ) {
+        console.error( '[CDDA-BROSER] data pack ensure failed: ' + UTF8ToString( spec ), e );
+        return 0;
+    }
+} );
+#endif
