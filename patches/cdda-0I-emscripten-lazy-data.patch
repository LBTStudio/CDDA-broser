diff --git a/src/cata_web_packs.h b/src/cata_web_packs.h
new file mode 100644
index 0000000..da3e234
--- /dev/null
+++ b/src/cata_web_packs.h
@@ -0,0 +1,53 @@
+#pragma once
+#ifndef CATA_SRC_CATA_WEB_PACKS_H
+#define CATA_SRC_CATA_WEB_PACKS_H
+
+#include <string>
+
+// ==================================================================
+// [CDDA-BROSER] ブラウザ版の分割データパックを読み込み直前に差し込む
+// ==================================================================
+// 背景:
+//   ブラウザ版の配布物は、メインメニューに到達するまでに全体の約 25%
+//   （実測 5,892 ファイル中 74 / 134.6MB 中 33.6MB）しか読まない。
+//   残りの大半は /data/json（世界を開始するまで一度も読まれない）と
+//   未選択 tileset の画像である。そこで配布物を起動パックと追加パックに
+//   分け、シェル (shell/lazydata.js) が必要な瞬間にだけ
+//   Module.LZ4.loadPackage で仮想 FS へ差し込む。
+//
+// このフックの役割:
+//   差し込みは非同期（ネットワーク）なので、読み込みを始める前に
+//   await できる場所が要る。これはこのビルドで既に使われている仕組み
+//   （Asyncify / JSPI）で、ゲームのロジックには触らない。
+//
+// 分割していない配布物では、シェル側に Module['cddaEnsurePack'] が
+// 存在しないため即座に 0 を返す。つまり従来と完全に同じ挙動になる。
+#if defined( EMSCRIPTEN )
+
+// 【なぜ宣言だけをヘッダに置くのか】
+// EM_ASYNC_JS の実体はかなり広いマクロで、展開すると __em_js__ という
+// 名前のシンボルを定義する。これをヘッダに書くと、include した翻訳単位の
+// 数だけ同じシンボルが定義され、リンク時に衝突する。したがって実体は
+// src/init.cpp に 1 つだけ置き、ここでは宣言と薄いラッパーだけを持つ。
+extern "C" int cata_web_ensure_pack_js( const char *spec );
+
+// spec はそのまま JS 側に渡る。
+//   "data/json" などのパス → そのパスを含むパック
+//   "gfx:<tileset id>"     → その tileset の画像パック
+inline void cata_web_ensure_pack( const std::string &spec )
+{
+    if( spec.empty() ) {
+        return;
+    }
+    cata_web_ensure_pack_js( spec.c_str() );
+}
+
+#else
+
+inline void cata_web_ensure_pack( const std::string & )
+{
+}
+
+#endif
+
+#endif // CATA_SRC_CATA_WEB_PACKS_H
