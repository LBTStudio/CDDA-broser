# CDDA 0.I browser: make martial-style selection reachable with C key
#
# The upstream DEFAULTMODE binding uses "_" for pick_style and "c" for close.
# For this browser distribution, use plain c for martial-style selection and
# move close-door to Alt+C. Shift+C remains the existing chat-with-NPC binding.
# This avoids duplicate unmodified-key bindings inside DEFAULTMODE.
--- a/data/raw/keybindings.json
+++ b/data/raw/keybindings.json
@@ -2377,7 +2377,7 @@
   {
     "type": "keybinding",
     "name": "Close door",
     "category": "DEFAULTMODE",
     "id": "close",
-    "bindings": [ { "input_method": "keyboard_any", "key": "c" } ]
+    "bindings": [ { "input_method": "keyboard_code", "key": "c", "mod": [ "alt" ] } ]
   },
@@ -2580,7 +2580,7 @@
   {
     "type": "keybinding",
     "name": "Select martial arts style",
     "category": "DEFAULTMODE",
     "id": "pick_style",
-    "bindings": [ { "input_method": "keyboard_char", "key": "_" }, { "input_method": "keyboard_code", "key": "-", "mod": [ "shift" ] } ]
+    "bindings": [ { "input_method": "keyboard_char", "key": "_" }, { "input_method": "keyboard_code", "key": "-", "mod": [ "shift" ] }, { "input_method": "keyboard_code", "key": "c" } ]
   },
