+bool activity_fast()
+{
+    return EM_ASM_INT( return window.CDDA_ACTIVITY_FAST !== false; ) != 0;
+}
+
+void pace_activity( const bool enabled )
+{
+    static double last_turn_ms = 0.0;
+    if( !enabled ) {
+        last_turn_ms = 0.0;
+        return;
+    }
+    const double now = now_ms();
+    const double remaining = 50.0 - ( now - last_turn_ms );
+    if( last_turn_ms > 0.0 && remaining > 0.0 && remaining <= 50.0 ) {
+        wait_for_input( static_cast<int>( remaining ) + 1 );
+    }
+    // Do not accumulate pacing debt across expensive turns or modal dialogs.
+    last_turn_ms = now_ms();
+}
