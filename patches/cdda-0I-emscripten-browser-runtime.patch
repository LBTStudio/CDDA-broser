 EM_ASYNC_JS( void, mount_idbfs, ( const char *user_dir ), {
     const mountPoint = UTF8ToString( user_dir );
 
+    // Bound structured-clone pressure to one file request at a time, rather
+    // than queueing every changed save file in one synchronous JS task.
+    // Keep the stock schema and one atomic IDB transaction per reconcile.
+    const originalReconcile = IDBFS.reconcile;
+    IDBFS.reconcile = function( src, dst, callback ) {
+        if( src.type !== 'local' || dst.type !== 'remote' ) {
+            return originalReconcile( src, dst, callback );
+        }
+        const create = Object.keys( src.entries ).filter( function( path ) {
+            const old = dst.entries[path];
+            return !old || src.entries[path].timestamp.getTime() !== old.timestamp.getTime();
+        } ).sort();
+        const remove = Object.keys( dst.entries ).filter( function( path ) {
+            return !src.entries[path];
+        } ).sort().reverse();
+        if( !create.length && !remove.length ) {
+            callback( null );
+            return;
+        }
+        let tx, store, failure = null, settled = false, nextCreate = 0, nextRemove = 0;
+        function finish( err ) {
+            if( settled ) { return; }
+            settled = true;
+            callback( err );
+        }
+        function abort( err ) {
+            if( failure || settled ) { return; }
+            failure = err || new Error( 'IDBFS transaction aborted' );
+            // Wait for onabort before permitting the retry to start.
+            try { tx.abort(); } catch( abortError ) { finish( failure ); }
+        }
+        function next() {
+            if( failure || settled ) { return; }
+            try {
+                if( nextCreate < create.length ) {
+                    const path = create[nextCreate++];
+                    IDBFS.loadLocalEntry( path, function( err, entry ) {
+                        if( err ) { abort( err ); return; }
+                        try {
+                            const request = store.put( entry, path );
+                            request.onsuccess = next;
+                            request.onerror = function( event ) {
+                                event.preventDefault();
+                                abort( request.error );
+                            };
+                        } catch( writeError ) { abort( writeError ); }
+                    } );
+                } else if( nextRemove < remove.length ) {
+                    const request = store.delete( remove[nextRemove++] );
+                    request.onsuccess = next;
+                    request.onerror = function( event ) {
+                        event.preventDefault();
+                        abort( request.error );
+                    };
+                }
+                // The last request drains naturally into oncomplete. Starting
+                // the next request directly in onsuccess keeps the tx active.
+            } catch( readError ) { abort( readError ); }
+        }
+        try {
+            tx = dst.db.transaction( [IDBFS.DB_STORE_NAME], 'readwrite' );
+            tx.oncomplete = function() { finish( failure ); };
+            tx.onabort = function() {
+                finish( failure || tx.error || new Error( 'IDBFS transaction aborted' ) );
+            };
+            tx.onerror = function( event ) {
+                event.preventDefault();
+                abort( event.target.error );
+            };
+            store = tx.objectStore( IDBFS.DB_STORE_NAME );
+            next();
+        } catch( transactionError ) {
+            if( tx ) { abort( transactionError ); } else { finish( transactionError ); }
+        }
+    };
