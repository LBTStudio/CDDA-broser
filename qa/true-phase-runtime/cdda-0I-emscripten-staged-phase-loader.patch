+EM_ASYNC_JS( void, staged_ensure_world_groups, ( const char *groups ), {
+    if( !window.CDDA_STAGED_PHASES_ENABLED ) {
+        return;
+    }
+    if( typeof window.CDDA_STAGED_ENSURE_GROUPS !== "function" ) {
+        throw new Error( "CDDA staged world package barrier is unavailable" );
+    }
+    const names = UTF8ToString( groups ).split( "\n" ).filter( function( name ) {
+        return name.length > 0;
+    } );
+    await window.CDDA_STAGED_ENSURE_GROUPS( names );
+} );
+
+EM_ASYNC_JS( void, staged_ensure_world_mods, ( const char *mod_ids ), {
+    if( !window.CDDA_STAGED_PHASES_ENABLED ) {
+        return;
+    }
+    if( typeof window.CDDA_STAGED_ENSURE_MODS !== "function" ) {
+        throw new Error( "CDDA staged MOD package barrier is unavailable" );
+    }
+    const ids = UTF8ToString( mod_ids ).split( "\n" ).filter( function( id ) {
+        return id.length > 0;
+    } );
+    await window.CDDA_STAGED_ENSURE_MODS( ids );
+} );
+
+static void ensure_staged_world_core_data()
+{
+    staged_ensure_world_groups( "world-core-support\nworld-core-json" );
+}
+
+static void ensure_staged_world_mod_data( const std::vector<mod_id> &mods )
+{
+    std::string mod_ids;
+    for( const mod_id &mod : mods ) {
+        if( mod.is_valid() ) {
+            mod_ids += mod.str();
+            mod_ids += '\n';
+        }
+    }
+    staged_ensure_world_mods( mod_ids.c_str() );
+}
